CMakeFiles/
CTestTestfile.cmake
Testing/
cmake_install.cmake
install_manifest.txt
*.o
*.a
*.dylib
*.dSYM/

# Local assets, environments and scratch state. .cache holds the 100GB+ pinned
# checkpoints, prepared records and ad-hoc experiment directories.
.cache/
.venv/
__pycache__/
*.pyc
models/
*.safetensors
*.gguf
*.bin
*.pt
*.pth

# Benchmark evidence. Only the stage report and its small summaries are
# versioned; raw captures, fixtures, logs, snapshots of the source tree and
# archived build trees stay on disk and are published separately. See
# docs/README.md.
docs/benchmarks/**
!docs/benchmarks/**/
!docs/benchmarks/**/*.md
!docs/benchmarks/**/summary.json
!docs/benchmarks/**/analysis.json
!docs/benchmarks/**/decision.json
docs/benchmarks/**/*-sources/**
docs/benchmarks/**/archive/**

# Evidence files that scripts read as fixed inputs stay versioned.
!docs/benchmarks/2026-09-08-validation/workload-2k.json
!docs/benchmarks/2026-09-09-sparse-attention/configs.json
!docs/benchmarks/2026-09-10-residency-paired/raw/pair-0-off.json
!docs/benchmarks/2026-09-10-slru-screen/raw/pair-0-clock.json
!docs/benchmarks/2026-09-11-q8-confirmation/raw/workload.json
!docs/benchmarks/2026-09-12-route-five-pairs/raw/workload.json
!docs/benchmarks/2026-09-13-buffer-costs/raw/normal.json
!docs/benchmarks/2026-09-14-combined-q4/integration-origin.json
!docs/benchmarks/2026-09-16-perfect-draft/screen-03/validate-1.json
!docs/benchmarks/2026-09-17-verifier-horizon/tiled-early-01/pair-0-width-8.json
